<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.tm4e.registry.grammars">
      <grammar
            path="grammars/TypeScript.tmLanguage.json"
            scopeName="source.ts">
      </grammar>
      <scopeNameContentTypeBinding
            contentTypeId="org.eclipse.tm4e.ui.tests.testContentType"
            scopeName="source.ts">
      </scopeNameContentTypeBinding>
      <!-- Also bound by org.eclipse.tm4e.languageconfiguration.tests (cross-bundle bindings). This owner binding's ID
           sorts after those, so a pure ID order would not put it first. -->
      <grammar
            path="grammars/cross-bundle.tmLanguage.json"
            scopeName="source.tm4e-cross-bundle">
      </grammar>
      <scopeNameContentTypeBinding
            contentTypeId="org.eclipse.tm4e.ui.tests.crossBundleOwner"
            scopeName="source.tm4e-cross-bundle">
      </scopeNameContentTypeBinding>
   </extension>
   <extension
         point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            base-type="org.eclipse.core.runtime.text"
            file-extensions="ts"
            id="org.eclipse.tm4e.ui.tests.testContentType"
            name="Test Content Type for TM4E (typescipt)"
            priority="normal">
      </content-type>
      <content-type
            base-type="org.eclipse.tm4e.ui.tests.testContentType"
            file-names="child.ts"
            id="org.eclipse.tm4e.ui.tests.testContentType.child"
            name="Child of test content-type"
            priority="normal">
      </content-type>
      <content-type
            base-type="org.eclipse.core.runtime.text"
            id="org.eclipse.tm4e.ui.tests.crossBundleOwner"
            name="Test content type bound by the grammar's own bundle"
            priority="normal">
      </content-type>
   </extension>
   <extension
         point="org.eclipse.ui.genericeditor.presentationReconcilers">
      <presentationReconciler
            class="org.eclipse.tm4e.ui.text.TMPresentationReconciler"
            contentType="org.eclipse.tm4e.ui.tests.testContentType">
      </presentationReconciler>
   </extension>
   <extension
         point="org.eclipse.tm4e.ui.samples">
      <sample
            name="org.eclipse.tm4e.ui.tests.sample1"
            path="grammars/sample.ts"
            scopeName="source.ts">
      </sample>
   </extension>

</plugin>
